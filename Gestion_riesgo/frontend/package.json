{
  "name": "sgr-jamundi-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/postbuild.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "data:refresh": "tsx scripts/refresh-snapshot.ts",
    "data:refresh:inst": "tsx scripts/refresh-inst-educativas-snapshot.ts",
    "data:refresh:equip": "tsx scripts/refresh-equipamientos-snapshot.ts",
    "data:check-pestanas": "tsx scripts/check-nuevas-pestanas.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^22",
    "@types/papaparse": "^5.5.2",
    "fake-indexeddb": "^6.2.5",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@lucide/svelte": "^1.31.0",
    "browser-image-compression": "^2.0.2",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "papaparse": "^5.6.0",
    "pdf-lib": "^1.17.1"
  }
}
